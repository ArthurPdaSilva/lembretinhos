{
	"expo": {
		"name": "Lembretinhos",
		"slug": "lembretinhos",
		"scheme": "lembretinhos",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"platforms": ["android"],
		"android": {
			"package": "com.arthurpsilva.lembretinhos",
			"softwareKeyboardLayoutMode": "resize",
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"monochromeImage": "./assets/monochrome-icon.png",
				"backgroundColor": "#FFFBF0"
			},
			"permissions": [
				"android.permission.POST_NOTIFICATIONS",
				"android.permission.RECEIVE_BOOT_COMPLETED"
			]
		},
		"plugins": [
			"expo-status-bar",
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#FFFBF0",
					"dark": {
						"backgroundColor": "#17140E"
					}
				}
			],
			"expo-sqlite",
			[
				"expo-notifications",
				{
					"icon": "./assets/notification-icon.png",
					"color": "#F2A900",
					"defaultChannel": "reminders"
				}
			],
			"expo-background-task",
			"@react-native-community/datetimepicker",
			"expo-font",
			"expo-asset",
			[
				"expo-build-properties",
				{
					"android": {
						"extraProguardRules": "# WorkManager (usado pelo expo-background-task) cria o banco Room por reflexão.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n"
					}
				}
			]
		],
		"extra": {
			"eas": {
				"projectId": "1f7d6632-0ffc-4669-a7dd-f0119aaeb135"
			}
		},
		"owner": "nelsin_montana"
	}
}
